.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
}

.interact-prompt {
    color: rgb(230, 200, 140);
    font-size: 28px;
    -unity-text-align: middle-center;
    margin-bottom: 140px;
    background-color: rgba(10, 8, 5, 0.6);
    padding: 6px 16px;
    border-radius: 6px;
}

.toast {
    position: absolute;
    top: 60px;
    color: rgb(230, 200, 140);
    font-size: 26px;
    -unity-text-align: middle-center;
    background-color: rgba(10, 8, 5, 0.65);
    padding: 8px 18px;
    border-radius: 6px;
}

.hud-hidden {
    display: none;
}
